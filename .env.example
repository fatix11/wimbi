# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated. Local dev default (localhost,127.0.0.1) applies if unset.
DJANGO_ALLOWED_HOSTS=
# True only once the ALB/domain actually terminates TLS — see infra/aws/README.md.
DJANGO_HTTPS=False

# Postgres (docker-compose defaults shown — override if you point at a different instance)
POSTGRES_DB=wimbi
POSTGRES_USER=wimbi
POSTGRES_PASSWORD=wimbi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (provisioned for Celery, per _docs/architectural_decisions.md ADR-001 — no tasks use it yet)
REDIS_URL=redis://localhost:6379/0

# Snowflake — not read by the app directly (ADR-003: Airbyte lands data into
# Postgres' analytics_mirror schema). Kept here only as a reference for
# configuring Airbyte's Snowflake source connector.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
