# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Django
db.sqlite3
staticfiles/

# Env
.env
!.env.example

# Reflex
frontend/.web/
frontend/*.db
.states/

# Testing
/test-results/
/playwright-report/
/playwright/.cache/
node_modules/

# OS
.DS_Store
data/raw/**/*.csv
!data/raw/.gitkeep

# Terraform (infra/aws/) — state and real secrets never get committed;
# .terraform.lock.hcl DOES get committed (pins provider versions), so it's
# deliberately not listed here.
infra/aws/.terraform/
infra/aws/terraform.tfstate
infra/aws/terraform.tfstate.backup
infra/aws/*.tfvars
!infra/aws/terraform.tfvars.example
infra/aws/bulk_uploader_data.json
