# Auth.js / NextAuth
# Generate one with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=

# Data source: "mock" (default, fixture-backed) or "snowflake"
WIMBI_DATA_SOURCE=mock

# Snowflake (ANALYTICS.REPORTING) — required only when WIMBI_DATA_SOURCE=snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=REPORTING
SNOWFLAKE_ROLE=

# Keycloak SSO — not wired up yet (a dev Credentials provider is active
# instead, see src/auth/dev-users.ts). Once a realm/client exists, add
# next-auth's generic OIDC provider in src/auth/config.ts using these.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
