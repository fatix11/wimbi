# Copy to terraform.tfvars (gitignored — never commit real secrets) and
# fill in real values. See README.md for how to get container_image.

aws_region  = "eu-north-1"
environment = "prod"

# Generate fresh: python -c "import secrets; print(secrets.token_urlsafe(50))"
django_secret_key = ""

# Generate a real random password — not the local docker-compose "wimbi"
db_password = ""

# Set after the first `docker build`/`docker push` — see README step 4.
# Placeholder lets `terraform plan` run before an image exists; `apply`
# will fail on the ECS service until this points at something real.
container_image = "<account-id>.dkr.ecr.eu-north-1.amazonaws.com/wimbi-prod:latest"

# Leave blank until the first apply gives you the ALB's DNS name, then set
# it explicitly and re-apply (otherwise it defaults to that same DNS name
# automatically — see ecs.tf).
django_allowed_hosts = ""

# Bridge-period only (see aws_migration.md) — RDS needs a public endpoint
# for OAF's external Airbyte to reach it without VPC peering. Revert to
# false once this migrates into OAF's own AWS account.
# db_publicly_accessible = true

# The addresses OAF's Airbyte actually connects from, found via VPC Flow
# Logs (see README's "Connecting OAF's Airbyte" section). Until this is
# set, db_publicly_accessible alone does NOT open RDS to the internet —
# the security group still blocks everything except the app's own tasks.
# A list because observed egress used more than one address; see the
# variable's own note on when this can go stale.
# airbyte_source_cidrs = ["52.214.150.190/32", "54.229.101.211/32"]
